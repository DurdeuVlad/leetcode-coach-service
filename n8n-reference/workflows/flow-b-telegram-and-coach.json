    {
      "parameters": {
        "jsCode": "// Flow B pick branch — parse user 'pick' reply (e.g. '2 5') into <=2 items.\nconst trigger = $('Telegram Trigger (incoming reply)').first().json;\nconst text = (trigger.message?.text || '').trim();\nconst nums = (text.match(/\\d+/g) || []).map(Number).filter(n => n >= 1);\nconst picks = nums.slice(0, 2);\n\nif (picks.length === 0) {\n  return [{ json: { _skip: true, raw: text } }];\n}\n\nconst today = $('Data Table (get today open)').all()\n  .map(i => i.json)\n  .filter(r => r.status === 'open' && r.problem_slug);\n\nconst chosen = picks\n  .map(idx => today[idx - 1])\n  .filter(Boolean)\n  .map(r => ({\n    json: {\n      problem_slug: r.problem_slug,\n      problem_title: r.problem_title || r.problem_slug,\n      problem_url: r.problem_url || '',\n      difficulty: r.difficulty || 'unknown',\n      tags: r.tags || '',\n      reasoning: r.reasoning || '',\n      coaching_hint: r.coaching_hint || '',\n      proposed_message_id: r.message_id\n    }\n  }));\n\nif (chosen.length === 0) {\n  return [{ json: { _skip: true, raw: text } }];\n}\nreturn chosen;\n"
      },
