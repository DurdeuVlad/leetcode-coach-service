    {
      "parameters": {
        "jsCode": "// Flow B coach branch — correlate a code reply to a problem.\n// Path 1 (exact): reply_to pointed at a known per-problem message.\n// Path 2 (fuzzy): no reply_to — match by problem title substring in today's open rows.\n// Path 3 (ask): ambiguous or no match — ask user.\nconst trigger = $('Telegram Trigger (incoming reply)').first().json;\nconst replyTo = trigger.message?.reply_to_message;\n\nif (replyTo && replyTo.message_id) {\n  const exact = $('Data Table (lookup by message_id)').first().json;\n  if (exact && exact.message_id) {\n    return [{ json: { ...exact, correlation: 'exact', user_text: trigger.message?.text || '' } }];\n  }\n}\n\nconst openRows = $('Data Table (get today open)').all().map(i => i.json);\nconst text = (trigger.message?.text || '').toLowerCase();\nconst matches = openRows.filter(r => {\n  const t = (r.problem_title || '').toLowerCase();\n  return text.includes(t) || t.includes(text);\n});\n\nif (matches.length === 1) {\n  return [{ json: { ...matches[0], correlation: 'fuzzy', user_text: trigger.message?.text || '' } }];\n}\n\nreturn [{ json: { _ask: true, candidates: matches.map(r => r.problem_title), user_text: trigger.message?.text || '' } }];\n"
      },
