# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.eggs/

# Virtual envs
.venv/
venv/
env/

# Secrets — never commit .env (NFR-4). Use .env.example for keys only.
.env
.env.*
!.env.example

# uv — lockfile IS committed for reproducible Coolify builds (strongest pin).
# Override global ~/.gitignore_global (*.lock) which would otherwise exclude it.
!uv.lock

# Tests / coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Env / secrets — NEVER commit
.env
.env.*
!.env.example

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Docker
*.pid

# Temporary scratch files (agent working files, not source)
.tmp_*
.local-*.db
ANTIGRAVITY_DEPLOY_PROMPT.md
ANTIGRAVITY_DIAGNOSE_PROMPT.md
