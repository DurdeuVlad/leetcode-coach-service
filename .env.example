# LeetCode Coach — env vars. Copy to .env and fill in values.
# No values are committed to the repo (NFR-4). Coolify injects these at runtime.

# Database (Coolify-managed Postgres service connection string)
DATABASE_URL=postgresql+psycopg://user:pass@host:5432/leetcode_coach

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public HTTPS URL Telegram will POST updates to (set after Coolify gives the app a domain)
TELEGRAM_WEBHOOK_URL=
# Secret token echoed back in X-Telegram-Bot-Api-Secret-Token on every webhook POST
TELEGRAM_WEBHOOK_SECRET=

# LLM
OPENAI_API_KEY=
GEMINI_API_KEY=

# Google Tasks (OAuth2 refresh-token flow — see docs/architecture.md §6)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_TASKS_LIST_ID=

# YouTube search via SearXNG (homelab) — replaces YouTube Data API.
# Leave blank to disable YouTube enrichment (callers skip, not hard error).
SEARXNG_URL=https://search.example.com

# Browserless (homelab) — primary path for LeetCode GraphQL (per
# business-requirements.md §8 #4). Leave blank to disable (GraphQL calls
# raise LeetCodeFetchError immediately).
BROWSERLESS_URL=https://browserless.example.com

# LeetCode
LEETCODE_USERNAME=

# Runtime
TIMEZONE=Europe/Bucharest
LOG_LEVEL=INFO
