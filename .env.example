# LeetCode Coach — env vars. Copy to .env and fill in values.
# No values are committed to the repo (NFR-4). Coolify injects these at runtime.

# Database (Coolify-managed Postgres service connection string)
DATABASE_URL=postgresql+psycopg://user:pass@host:5432/leetcode_coach
# V2 import only: read-only connection to the old database. Leave blank after migration.
LEGACY_DATABASE_URL=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public HTTPS URL Telegram will POST updates to (set after Coolify gives the app a domain)
TELEGRAM_WEBHOOK_URL=
# Required. Secret token echoed back in X-Telegram-Bot-Api-Secret-Token on every
# webhook POST; the app refuses to start without it. Without this check, anyone
# who learns/guesses TELEGRAM_CHAT_ID (not itself secret) could POST forged
# updates straight into the agent loop. Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
# Agentic V2 controller + one-shot read-only advisor.
TERRA_MODEL=gpt-5.6-terra
SOL_ADVISOR_MODEL=gpt-5.6-sol
AGENT_MAX_TURNS=8
APPROVAL_TTL_HOURS=24
PROMPT_CACHE_TTL=30m
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# YouTube search via SearXNG (homelab) — replaces YouTube Data API.
# Leave blank to disable YouTube enrichment (callers skip, not hard error).
SEARXNG_URL=https://search.example.com

# Browserless (homelab) — primary path for LeetCode GraphQL (per
# business-requirements.md §8 #4). Leave blank to disable (GraphQL calls
# raise LeetCodeFetchError immediately).
# For Browserless Cloud: set BROWSERLESS_URL=https://chrome.browserless.io
# and BROWSERLESS_TOKEN=<your cloud token>. Homelab needs no token.
BROWSERLESS_URL=https://browserless.example.com
BROWSERLESS_TOKEN=

# LeetCode
LEETCODE_USERNAME=

# Runtime
TIMEZONE=Europe/Bucharest
LOG_LEVEL=INFO

# Terminal simulator (dev/test harness — NOT a production runtime).
# `python -m leetcode_coach.scripts.terminal` boots a REPL that drives the
# real Flow A / Flow B / slash-command logic against the configured Postgres,
# printing simulated Telegram output to stdout. No new env vars — it reuses
# the ones above. Recommended local .env for prompt engineering:
#   DATABASE_URL=postgresql+psycopg://leetcode:leetcode@localhost:5432/leetcode_coach
#   TELEGRAM_BOT_TOKEN=mock            # or leave empty — outbound is simulated
#   TELEGRAM_CHAT_ID=123456            # any int; the REPL uses this as chat_id
#   OPENAI_API_KEY=<real key>          # real calls for prompt iteration; or "mock"
#   GEMINI_API_KEY=mock                # unused unless OpenAI falls back
# Start Postgres first:  docker compose up -d postgres  &&  alembic upgrade head
