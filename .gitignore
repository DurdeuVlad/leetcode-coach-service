# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.eggs/

# Virtual envs
.venv/
venv/
env/

# uv — lockfile IS committed for reproducible Coolify builds (strongest pin).
# Override global ~/.gitignore_global (*.lock) which would otherwise exclude it.
!uv.lock

# Tests / coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Env / secrets — NEVER commit
.env
.env.*
!.env.example

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Docker
*.pid
