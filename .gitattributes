# Normalize all text files to LF in the repo (regardless of OS).
# Windows devs get CRLF on checkout; git converts back to LF on commit.
# Without this, entrypoint.sh can ship with CRLF and break Docker on Linux.
* text=auto eol=lf

# Shell scripts MUST be LF — CRLF breaks #!/usr/bin/env sh in containers.
*.sh text eol=lf
entrypoint.sh text eol=lf

# Binary files — no line-ending conversion.
*.png binary
*.jpg binary
*.ico binary
